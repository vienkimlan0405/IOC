package com.example.demo.controller;

import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.util.*;

@RestController
@RequestMapping("/api/json-demo")
public class JsonDemoController {

    // 1. Trả {"name":"An","age":20}
    @GetMapping("/object")
    public Map<String, Object> getObject() {
        Map<String, Object> result = new HashMap<>();
        result.put("name", "An");
        result.put("age", 20);
        return result;
    }

    // 2. Trả ["java","spring","json"]
    @GetMapping("/array")
    public List<String> getArray() {
        return List.of("java", "spring", "json");
    }

    // 3. Trả {"user": {"id": 1, "name": "Bình"}}
    @GetMapping("/nested-object")
    public Map<String, Object> getNestedObject() {
        Map<String, Object> user = new HashMap<>();
        user.put("id", 1);
        user.put("name", "Bình");

        Map<String, Object> result = new HashMap<>();
        result.put("user", user);
        return result;
    }

    // 4. Trả [{"id":1,"name":"A"},{"id":2,"name":"B"}]
    @GetMapping("/list-objects")
    public List<Map<String, Object>> getListObjects() {
        Map<String, Object> user1 = Map.of("id", 1, "name", "A");
        Map<String, Object> user2 = Map.of("id", 2, "name", "B");
        return List.of(user1, user2);
    }

    // 5. Trả {"orders":[{"id":1,"total":100},{"id":2,"total":200}]}
    @GetMapping("/orders")
    public Map<String, Object> getOrders() {
        Map<String, Object> order1 = Map.of("id", 1, "total", 100);
        Map<String, Object> order2 = Map.of("id", 2, "total", 200);

        Map<String, Object> result = new HashMap<>();
        result.put("orders", List.of(order1, order2));
        return result;
    }
}
